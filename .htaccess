RewriteEngine On

# Bloqueia diretórios internos
RewriteRule ^(app|config|database|storage|cron)/ - [F,L]

# Se a requisição já aponta para public, deixa seguir
RewriteRule ^public/ - [L]

# Arquivos físicos da raiz podem ser acessados somente se necessários
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Produção em /crm: serve public/ sem expor /public na URL
RewriteRule ^(.*)$ public/$1 [L,QSA]
